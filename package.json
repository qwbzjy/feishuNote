{
  "name": "feishunote",
  "version": "0.1.3",
  "description": "飞书风格的本地化 Markdown 文档客户端",
  "main": "./out/main/index.js",
  "author": "wenbo",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "start": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "bash scripts/build-dmg.sh both",
    "postinstall": "electron-builder install-app-deps",
    "dist:x64": "bash scripts/build-dmg.sh x64",
    "dist:arm64": "bash scripts/build-dmg.sh arm64",
    "dist:win": "bash scripts/build-win.sh",
    "dist:all": "bash scripts/build-all.sh"
  },
  "dependencies": {
    "@tiptap/core": "3.32.2",
    "@tiptap/extension-character-count": "3.32.2",
    "@tiptap/extension-code-block-lowlight": "3.32.2",
    "@tiptap/extension-color": "3.32.2",
    "@tiptap/extension-details": "3.32.2",
    "@tiptap/extension-drag-handle-react": "3.32.2",
    "@tiptap/extension-highlight": "3.32.2",
    "@tiptap/extension-image": "3.32.2",
    "@tiptap/extension-link": "3.32.2",
    "@tiptap/extension-list": "3.32.2",
    "@tiptap/extension-placeholder": "3.32.2",
    "@tiptap/extension-table": "3.32.2",
    "@tiptap/extension-text-align": "3.32.2",
    "@tiptap/extension-text-style": "3.32.2",
    "@tiptap/extension-underline": "3.32.2",
    "@tiptap/markdown": "3.32.2",
    "@tiptap/pm": "3.32.2",
    "@tiptap/react": "3.32.2",
    "@tiptap/starter-kit": "3.32.2",
    "@tiptap/suggestion": "3.32.2",
    "better-sqlite3": "13.0.3",
    "js-yaml": "4.1.0",
    "lowlight": "3.3.0",
    "lucide-react": "1.66.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/js-yaml": "4.0.9",
    "@types/node": "24.9.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "playwright-core": "1.64.1",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
